  <script>
   (function () {
  var proto = XMLHttpRequest.prototype;
  var open = proto.open, setRequestHeader = proto.setRequestHeader, send = proto.send;
  var TOKEN_KEY = 'base44_access_token';
  var storedTokenHeader = function () {
    try { return 'Bearer ' + localStorage.getItem(TOKEN_KEY); } catch (e) { return null; }
  };
  var forgetStoredToken = function () {
    try { localStorage.removeItem(TOKEN_KEY); localStorage.removeItem('token'); } catch (e) {}
  };

  proto.open = function (method, url) {
    this.__b44IsAuthCheck = /\/entities\/User\/me(\?|$)/.test(url);
    return open.apply(this, arguments);
  };

  proto.setRequestHeader = function (name, value) {
    if (this.__b44IsAuthCheck && name.toLowerCase() === 'authorization' && value === storedTokenHeader()) {
      this.__b44SentToken = value;
    }
    return setRequestHeader.call(this, name, value);
  };

  proto.send = function () {
    this.addEventListener('loadend', function () {
      var rejectedTokenStillStored = this.status === 401 && this.__b44SentToken === storedTokenHeader();
      if (rejectedTokenStillStored) forgetStoredToken();
    });
    return send.apply(this, arguments);
  };
})();
  </script>
