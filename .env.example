# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. Only public (browser-safe) values
# belong here — never put the Supabase service_role key in a VITE_ variable.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (Project Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
